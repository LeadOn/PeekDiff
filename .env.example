# --- Required ---
# GameOn API base URL. Used as the target of the /api/gameon proxy and to build image URLs.
NUXT_PUBLIC_GAME_ON_API_URL=https://gameon-api.valentinvirot.fr
NUXT_PUBLIC_KEYCLOAK_AUTHORITY=https://auth.valentinvirot.fr/realms/gameon
NUXT_PUBLIC_KEYCLOAK_CLIENT_ID=gameon-front-dev
NUXT_PUBLIC_KEYCLOAK_REALM=gameon

# --- Optional ---
# Overrides the proxy target server-side, e.g. to reach the API over a private network.
# Falls back to NUXT_PUBLIC_GAME_ON_API_URL when unset.
# NUXT_GAME_ON_API_URL=http://gameon-api.internal:8080

# Only needed if the Keycloak client is confidential. Left empty, the server treats it as a public
# client and relies on PKCE alone for the code exchange.
# NUXT_KEYCLOAK_CLIENT_SECRET=
